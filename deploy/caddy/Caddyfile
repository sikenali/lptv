# =============================================================================
# LPTV 远程访问 — 公网受信任 HTTPS 入口 (方案 2)
#
# 用途：把盒子平台自签证书的 rlptv.<盒名> 端点，包一层 Let's Encrypt 真证书，
#       让任何手机/平板/桌面浏览器零配置直接访问（不再报「证书不受信任」）。
#
# 原理：
#   Caddy 对外用 lptv.<域名> + 自动申请的真证书 (Let's Encrypt, 自动续期)；
#   对内反代到盒子的 rlptv.<盒名>（平台自签证书，内联链路安全，跳过校验）。
#   内部目标（/catlink/ → cde:7890, /rim/ → cde:8888, / → SPA）全部由盒子
#   平台原样转发，Caddy 无需关心，只做「真证书层」。
#
# 前置条件：
#   1) DNS：lptv.10012049.xyz A 记录 → 盒子公网 IP
#   2) 路由器端口映射：80 + 443 → 盒子（Caddy 所在主机）
#   3) 盒子内 rlptv.<盒名> 从 Caddy 所在主机可解析/可达
#
# 用法：
#   编辑下方 {BOX_UPSTREAM} 为盒子实际地址（默认 https://rlptv.lzc/）
#   caddy run --config Caddyfile    （或用 caddy start / systemd 常驻）
# =============================================================================

lptv.10012049.xyz {
	# 自动申请 + 续期 Let's Encrypt 证书（需 80/443 可达）。首次申请约 10-30s。
	# 如域名已解析但签发失败，看 caddy 日志：常见是 80 未映射/运营商封锁 ACME。
	tls {
		# 生产环境建议用 email 收续期失败告警（可留空，Caddy 用内置）
		# email you@example.com
	}

	# 反代到盒子平台端点（含 SPA + /catlink/ + /rim/ + /d/ 全部路径）
	# 内网链路信任：盒子用自签证书，此处跳过校验（仅 Caddy→盒子 这一段）。
	# 若你已把盒子 CA 导出并导入本机，可改用：
	#   tls_trust_pool file /etc/ssl/certs/box-ca.crt
	reverse_proxy {BOX_UPSTREAM} {
		transport http {
			tls_insecure_skip_verify
		}
	}

	# 便于排障：健康检查页 /lptv-health (无需登录)
	handle /lptv-health {
		respond "LPTV proxy OK" 200
	}

	# WebSocket (xpra /catlink/ 走 ws+wss) 由 reverse_proxy 自动支持，无需额外配置。

	# 访问日志 + 错误日志
	log {
		output file /var/log/caddy/lptv.access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format console
	}
	# 压缩（SPA/JS 较大）
	encode gzip
}
